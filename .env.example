# =============================================================================
# PRAN — Environment Variables (template)
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# Values marked (server only) must never be exposed to the browser.
# Only variables prefixed NEXT_PUBLIC_ are sent to the client.
# =============================================================================

# --- Supabase (database + auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # (server only) bypasses RLS — keep secret

# --- Razorpay (escrow pay-in) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                  # (server only) used to verify payment signatures
RAZORPAY_WEBHOOK_SECRET=              # (server only) used to verify webhook signatures

# --- Resend (transactional email) ---
RESEND_API_KEY=                       # (server only)
PRAN_TEAM_EMAIL=                      # where order + contact notifications are sent
PRAN_FROM_EMAIL=noreply@pranglobal.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # set to https://pranglobal.com in production
